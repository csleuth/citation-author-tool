# Copy to ~/.config/citation-author-tool/secrets (or set REFS_SECRETS_PATH), then: chmod 600 <that file>
# Each value is read only at the moment it is needed and is never printed or logged.

# OpenAI API key for the reader (refs/read.py) and the blind checker (checker/check.py).
OPENAI_API_KEY=

# A Wikipedia bot password from Special:BotPasswords (needed only for `python -m refs app --live` and `whoami`).
# WIKI_BOT_USER has the form YourUsername@BotPasswordName.
WIKI_BOT_USER=
WIKI_BOT_PASSWORD=
